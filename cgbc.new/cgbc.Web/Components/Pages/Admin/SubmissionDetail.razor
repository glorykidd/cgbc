@page "/admin/submissions/{Id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Submission Detail - CGBC Admin</PageTitle>

@if (card == null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Submission from @card.Name</h2>
        <a href="/admin/submissions" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Name:</strong>
                    <p>@card.Name</p>
                </div>
                <div class="col-md-6">
                    <strong>Email:</strong>
                    <p><a href="mailto:@card.Email">@card.Email</a></p>
                </div>
                <div class="col-md-6">
                    <strong>Phone:</strong>
                    <p>@(card.Phone ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <strong>Address:</strong>
                    <p>@(card.Address ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <strong>Visit Status:</strong>
                    <p>@card.VisitStatus</p>
                </div>
                <div class="col-md-6">
                    <strong>Wants Contact:</strong>
                    <p>@(card.WantsContact ? "Yes" : "No")</p>
                </div>
                <div class="col-md-6">
                    <strong>Preferred Communication:</strong>
                    <p>@(string.IsNullOrEmpty(card.PreferredCommunication) ? "N/A" : card.PreferredCommunication)</p>
                </div>
                <div class="col-md-6">
                    <strong>Contact Reason:</strong>
                    <p>@card.ContactReason</p>
                </div>
                @if (!string.IsNullOrEmpty(card.ContactReasonOther))
                {
                    <div class="col-12">
                        <strong>Contact Reason (Other):</strong>
                        <p>@card.ContactReasonOther</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(card.PrayerRequests))
                {
                    <div class="col-12">
                        <strong>Prayer Requests:</strong>
                        <p style="white-space: pre-wrap;">@card.PrayerRequests</p>
                    </div>
                }
                <div class="col-md-6">
                    <strong>Submitted:</strong>
                    <p>@card.SubmittedAt.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                </div>
                <div class="col-md-6">
                    <strong>Status:</strong>
                    <p>
                        <span class="badge @(card.IsRead ? "bg-secondary" : "bg-primary")">
                            @(card.IsRead ? "Read" : "Unread")
                        </span>
                    </p>
                </div>
                <div class="col-md-6">
                    <strong>Acknowledged:</strong>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="acknowledgedCheck"
                               checked="@card.IsAcknowledged"
                               @onchange="ToggleAcknowledged" />
                        <label class="form-check-label" for="acknowledgedCheck">
                            @(card.IsAcknowledged ? "Card has been reviewed" : "Mark as reviewed")
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-outline-primary" @onclick="ToggleRead">
            @(card.IsRead ? "Mark as Unread" : "Mark as Read")
        </button>
        <button class="btn btn-outline-secondary" @onclick="() => showForward = true">Forward</button>
        <button class="btn btn-outline-danger" @onclick="() => showDeleteConfirm = true">Delete</button>
    </div>

    <h5 class="mb-3">Internal Notes</h5>

    @if (card.Notes.Count == 0)
    {
        <p class="text-muted small mb-3">No notes yet.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var note in card.Notes)
            {
                <div class="card border-start border-3 border-success">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small">@note.CreatedBy</span>
                            <span class="text-muted small">@note.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                        </div>
                        <p class="mb-0 small" style="white-space: pre-wrap;">@note.Message</p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="card-body">
            <label class="form-label fw-semibold" for="noteText">Add Note</label>
            <textarea id="noteText" class="form-control mb-2" rows="4"
                      @bind="noteText" placeholder="Internal notes visible only to admins..."></textarea>
            @if (noteError != null)
            {
                <div class="text-danger small mb-2">@noteError</div>
            }
            @if (noteSuccess)
            {
                <div class="text-success small mb-2">Note saved.</div>
            }
            <button class="btn btn-primary" @onclick="AddNote" disabled="@noteSaving">
                @(noteSaving ? "Saving…" : "Save Note")
            </button>
        </div>
    </div>
}

@if (showForward)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Forward Connection Card</h5>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="forwardTo">Forward to email address</label>
                    <input id="forwardTo" type="email" class="form-control" @bind="forwardAddress" placeholder="recipient@example.com" />
                    @if (forwardError != null)
                    {
                        <div class="text-danger small mt-1">@forwardError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseForward">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecuteForward" disabled="@forwardSending">
                        @(forwardSending ? "Sending…" : "Send")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this submission? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private ConnectionCardService CardService { get; set; } = default!;
    [Inject] private EmailService EmailService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [CascadingParameter] private AuthenticationState AuthState { get; set; } = default!;

    private ConnectionCard? card;
    private string currentUserName = "Admin";
    private bool showDeleteConfirm;

    private bool showForward;
    private string forwardAddress = "";
    private string? forwardError;
    private bool forwardSending;

    private string noteText = "";
    private string? noteError;
    private bool noteSuccess;
    private bool noteSaving;

    protected override async Task OnInitializedAsync()
    {
        currentUserName = AuthState?.User.FindFirst("display_name")?.Value
            ?? AuthState?.User.Identity?.Name
            ?? "Admin";

        card = await CardService.GetByIdWithNotesAsync(Id);
        if (card != null && !card.IsRead)
        {
            await CardService.MarkAsReadAsync(Id);
            card.IsRead = true;
        }
    }

    private async Task ToggleRead()
    {
        if (card == null) return;
        await CardService.ToggleReadAsync(Id);
        card.IsRead = !card.IsRead;
    }

    private async Task ToggleAcknowledged(ChangeEventArgs e)
    {
        if (card == null) return;
        var acknowledged = (bool)(e.Value ?? false);
        await CardService.SetAcknowledgedAsync(Id, acknowledged);
        card.IsAcknowledged = acknowledged;
    }

    private async Task AddNote()
    {
        noteError = null;
        noteSuccess = false;

        if (string.IsNullOrWhiteSpace(noteText))
        {
            noteError = "Please enter a note before saving.";
            return;
        }

        noteSaving = true;
        try
        {
            await CardService.AddNoteAsync(Id, noteText.Trim(), currentUserName);
            noteText = "";
            noteSuccess = true;
        }
        finally
        {
            noteSaving = false;
        }
    }

    private async Task ExecuteForward()
    {
        forwardError = null;

        if (string.IsNullOrWhiteSpace(forwardAddress) || !forwardAddress.Contains('@'))
        {
            forwardError = "Please enter a valid email address.";
            return;
        }

        forwardSending = true;
        try
        {
            await EmailService.ForwardConnectionCardAsync(card!, forwardAddress.Trim());
            await CardService.AddNoteAsync(Id, $"Forwarded to {forwardAddress.Trim()}", currentUserName);
            showForward = false;
            forwardAddress = "";
        }
        finally
        {
            forwardSending = false;
        }
    }

    private void CloseForward()
    {
        showForward = false;
        forwardAddress = "";
        forwardError = null;
    }

    private async Task ExecuteDelete()
    {
        await CardService.DeleteAsync(Id);
        Nav.NavigateTo("/admin/submissions");
    }
}
